{
  "suite_name": "PARALLEL-CURRENT",
  "fixtures": {
    "positive": "fixtures/positive.loop",
    "diamond-example-inner-batch": "fixtures/diamond-example-inner-batch.loop",
    "jacobi-batch": "fixtures/jacobi-batch.loop",
    "dependent": "fixtures/dependent.loop"
  },
  "checks": [
    {
      "name": "parallel-current-positive",
      "fixture": "positive",
      "args": [
        "--parallel-current",
        "0"
      ],
      "expect": "success",
      "needle": "parallel for",
      "differs_from_args": []
    },
    {
      "name": "diamond-route-then-parallel-current-positive",
      "fixture": "positive",
      "args": [
        "--diamond-tile",
        "--parallel-current",
        "0"
      ],
      "expect": "success",
      "needle": "parallel for",
      "differs_from_args": [
        "--diamond-tile"
      ]
    },
    {
      "name": "diamond-current-combined-effect",
      "fixture": "diamond-example-inner-batch",
      "args": [
        "--diamond-tile",
        "--parallel-current",
        "0"
      ],
      "expect": "success",
      "needles": [
        "parallel for",
        "32 *",
        "/ 32",
        "i4 + (-1 * i5)"
      ],
      "differs_from_args": [
        "--diamond-tile"
      ]
    },
    {
      "name": "diamond-current-jacobi-batch-codegen-gap",
      "fixture": "jacobi-batch",
      "args": [
        "--diamond-tile",
        "--parallel-current",
        "0"
      ],
      "expect": "failure",
      "needle": "Annotated parallel codegen produced non-affine instruction trace loop"
    },
    {
      "name": "parallel-current-positive-iss",
      "fixture": "positive",
      "args": [
        "--iss",
        "--parallel-current",
        "0"
      ],
      "expect": "success",
      "needle": "parallel for",
      "differs_from_args": [
        "--iss"
      ]
    },
    {
      "name": "parallel-current-out-of-bounds",
      "fixture": "positive",
      "args": [
        "--parallel-current",
        "5"
      ],
      "expect": "failure",
      "needle": "Parallel validation failed"
    },
    {
      "name": "parallel-current-dependent",
      "fixture": "dependent",
      "args": [
        "--parallel-current",
        "0"
      ],
      "expect": "failure",
      "needle": "Parallel validation failed"
    }
  ]
}
