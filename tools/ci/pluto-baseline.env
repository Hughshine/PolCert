# Keep this file aligned with the Dockerfile ARG defaults.
# `PLUTO_IMAGE` is the image currently consumed by PolCert CI.
# `PLUTO_BASELINE_TAG` is the versioned name to use for the next published Pluto base image.
# The buggy baseline is built into the artifact only for miscompilation witnesses.
PLUTO_IMAGE=hughshine/pluto-verif@sha256:0e15a7614af280b02ab0dc31f110c3ee3f7a1fe3ee3d1b503cc3400d87b4f4ce
PLUTO_BASELINE_TAG=polcert-pluto-defensive-fixes-8c43c21
PLUTO_VERSIONED_IMAGE=hughshine/pluto-verif:polcert-pluto-defensive-fixes-8c43c21
PLUTO_GIT_REMOTE=https://github.com/verif-scop/pluto.git
PLUTO_GIT_COMMIT=8c43c210c9c08c5958198f22db4b54000380925e
PLUTO_BUGGY_GIT_REMOTE=https://github.com/verif-scop/pluto.git
PLUTO_BUGGY_GIT_COMMIT=6f43860b6c4cddeeca09189bf3073f05b78b14a5
PLUTO_BUGGY_ROOT=/opt/polcert/pluto-buggy
