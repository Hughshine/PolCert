{
  "suite_name": "SECOND-LEVEL-TILE",
  "fixtures": {
    "matmul-init": "fixtures/matmul-init.loop"
  },
  "checks": [
    {
      "name": "second-level-tile-supported",
      "fixture": "matmul-init",
      "args": [
        "--second-level-tile"
      ],
      "expect": "success",
      "needle": "== Optimized Loop ==",
      "differs_from_args": []
    },
    {
      "name": "second-level-tile-rejects-identity",
      "fixture": "matmul-init",
      "args": [
        "--second-level-tile",
        "--identity"
      ],
      "expect": "failure",
      "needle": "--second-level-tile with --identity requires --tile"
    },
    {
      "name": "second-level-tile-identity-tiled",
      "fixture": "matmul-init",
      "args": [
        "--second-level-tile",
        "--identity-tiled"
      ],
      "expect": "success",
      "needle": "== Optimized Loop ==",
      "needles": [
        "/ 256",
        "8 *",
        "32 *"
      ],
      "differs_from_args": [
        "--identity-tiled"
      ]
    },
    {
      "name": "second-level-tile-rejects-notile",
      "fixture": "matmul-init",
      "args": [
        "--second-level-tile",
        "--notile"
      ],
      "expect": "failure",
      "needle": "--second-level-tile requires tiling and cannot be combined with --notile"
    },
    {
      "name": "second-level-tile-parallel-current",
      "fixture": "matmul-init",
      "args": [
        "--second-level-tile",
        "--parallel-current",
        "0"
      ],
      "expect": "success",
      "needle": "parallel for",
      "differs_from_args": [
        "--second-level-tile"
      ]
    },
    {
      "name": "second-level-tile-parallel",
      "fixture": "matmul-init",
      "args": [
        "--second-level-tile",
        "--parallel"
      ],
      "expect": "success",
      "needle": "parallel for",
      "differs_from_args": [
        "--second-level-tile"
      ]
    }
  ]
}
