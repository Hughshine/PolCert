context(N);

for i0 in range(0, (1 + (N + -1))) {
  for i1 in range(0, (1 + (i0 + -1))) {
    for i2 in range(1, (1 + 1)) {
      for i3 in range(i1, (i1 + 1)) {
        for i4 in range(i0, (i0 + 1)) {
          a[i4] = 0;
        }
      }
    }
  }
  for i1 in range(i0, (i0 + 1)) {
    for i2 in range(0, (0 + 1)) {
      for i3 in range(i0, (i0 + 1)) {
        for i4 in range(0, (1 + (N + -1))) {
          a[i3] = 0;
        }
      }
    }
    for i2 in range(1, (1 + 1)) {
      for i3 in range(i0, (i0 + 1)) {
        for i4 in range(i3, (i3 + 1)) {
          a[i4] = 0;
        }
      }
    }
  }
  for i1 in range((i0 + 1), (1 + (N + -1))) {
    for i2 in range(1, (1 + 1)) {
      for i3 in range(i1, (i1 + 1)) {
        for i4 in range(i0, (i0 + 1)) {
          a[i4] = 0;
        }
      }
    }
  }
}
