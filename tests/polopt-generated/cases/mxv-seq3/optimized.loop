context(N);

if (1 <= N) {
  for i1 in range(0, N) {
    for i3 in range(0, N) {
      y[i1] = (y[i1] + (a[i1][i3] * x[i3]));
    }
    for i3 in range(0, N) {
      z[i3] = (z[i3] + (b[i3][i1] * y[i1]));
    }
  }
}
if (1 <= N) {
  for i1 in range(0, N) {
    for i3 in range(0, N) {
      w[i1] = (w[i1] + (b[i1][i3] * z[i3]));
    }
  }
}
