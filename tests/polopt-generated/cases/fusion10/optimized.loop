for i0 in range(0, 4) {
  if (i0 <= 1) {
    A[((2 * 0) + i0)] = 1;
  }
  if (2 <= i0) {
    for i3 in range((i0 + -2), (i0 + -1)) {
      A[((2 * 1) + i3)] = 1;
    }
  }
  for i1 in range(max(((i0 + 2) / 2), 1), min(((i0 + 4) / 2), 3)) {
    for i2 in range((i1 + -1), i1) {
      for i3 in range((i0 + (-2 * i2)), ((i0 + 1) + (-2 * i2))) {
        B[((2 * i2) + i3)] = A[((2 * i2) + i3)];
      }
    }
  }
}
