for i0 in range(0, (0 + 1)) {
  for i1 in range(0, 2) {
    for i2 in range(0, 2) {
      for i3 in range(i1, (i1 + 1)) {
        for i4 in range(i2, (i2 + 1)) {
          A[((2 * i3) + i4)] = 1;
        }
      }
    }
  }
}
for i0 in range(1, (1 + 1)) {
  for i1 in range(0, 2) {
    for i2 in range(0, 2) {
      for i3 in range(i1, (i1 + 1)) {
        for i4 in range(i2, (i2 + 1)) {
          B[((2 * i3) + i4)] = A[((2 * i3) + i4)];
        }
      }
    }
  }
}
