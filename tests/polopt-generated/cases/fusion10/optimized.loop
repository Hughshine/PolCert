for i0 in range(0, 4) {
  if (i0 <= 1) {
    A[((2 * 0) + i0)] = 1;
  }
  if (2 <= i0) {
    A[((2 * 1) + (i0 + -2))] = 1;
  }
  for i1 in range(max(((i0 + 2) / 2), 1), min(((i0 + 4) / 2), 3)) {
    B[((2 * (i1 + -1)) + (i0 + (-2 * (i1 + -1))))] = A[((2 * (i1 + -1)) + (i0 + (-2 * (i1 + -1))))];
  }
}
