context(N);

if (1 <= N) {
  for i2 in range(0, N) {
    C[0][i2] = (3 * B[(0 - 1)][(N - i2)]);
  }
}
for i0 in range(1, N) {
  for i2 in range(0, N) {
    for i3 in range((i0 + -1), i0) {
      B[i3][i2] = (2 * A[i3][i2]);
    }
  }
  for i2 in range(0, N) {
    C[i0][i2] = (3 * B[(i0 - 1)][(N - i2)]);
  }
}
if (1 <= N) {
  for i2 in range(0, N) {
    for i3 in range((N + -1), N) {
      B[i3][i2] = (2 * A[i3][i2]);
    }
  }
}
