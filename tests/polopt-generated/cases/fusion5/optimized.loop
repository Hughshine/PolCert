context(N);

if ((-1 * N) <= -1) {
  for i0 in range(0, (0 + 1)) {
    for i1 in range(0, (1 + (N + -1))) {
      for i2 in range(0, (1 + (N + -1))) {
        for i3 in range(i1, (i1 + 1)) {
          for i4 in range(i2, (i2 + 1)) {
            for i5 in range(0, (0 + 1)) {
              B[i3][i4] = (2 * A[i3][i4]);
            }
          }
        }
      }
    }
  }
}
if ((-1 * N) <= -1) {
  for i0 in range(1, (1 + 1)) {
    for i1 in range(0, (1 + (N + -1))) {
      for i2 in range(0, (1 + (N + -1))) {
        for i3 in range(i1, (i1 + 1)) {
          for i4 in range(i2, (i2 + 1)) {
            for i5 in range(0, (0 + 1)) {
              C[i3][i4] = (3 * B[(i3 - 1)][(N - i4)]);
            }
          }
        }
      }
    }
  }
}
