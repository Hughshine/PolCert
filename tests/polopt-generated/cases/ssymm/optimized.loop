context(NMAX);

if ((-1 * NMAX) <= -3) {
  for i0 in range(0, (1 + (NMAX + -1))) {
    for i1 in range(0, 2) {
      for i2 in range(0, (0 + 1)) {
        for i3 in range(0, (0 + 1)) {
          for i4 in range(0, (0 + 1)) {
            for i5 in range(i0, (i0 + 1)) {
              for i6 in range(i1, (i1 + 1)) {
                for i7 in range(0, (0 + 1)) {
                  c[i5][i6] = (c[i5][i6] + (a[i6][i6] * b[i5][i6]));
                }
              }
            }
          }
        }
      }
    }
    for i1 in range(2, (1 + (NMAX + -1))) {
      for i2 in range(0, (0 + 1)) {
