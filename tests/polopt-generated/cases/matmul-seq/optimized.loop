context(N);

if (1 <= N) {
  for i1 in range(0, N) {
    for i2 in range(0, N) {
      for i3 in range(0, N) {
        C[i1][i2] = (C[i1][i2] + (A[i1][i3] * B[i3][i2]));
      }
    }
  }
}
if (1 <= N) {
  for i1 in range(0, N) {
    for i2 in range(0, N) {
      for i3 in range(0, N) {
        D[i1][i2] = (D[i1][i2] + (C[i1][i3] * E[i3][i2]));
      }
    }
  }
}
