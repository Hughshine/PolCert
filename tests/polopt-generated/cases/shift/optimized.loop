context(n);

for i0 in range(0, (1 + (n + -1))) {
  for i1 in range(0, (0 + 1)) {
    for i2 in range(1, (1 + 1)) {
      for i3 in range(i0, (i0 + 1)) {
        for i4 in range(0, (0 + 1)) {
          a[i3][i4] = (b[i3][(i4 - 1)] + a[i3][(i4 - 1)]);
        }
      }
    }
  }
  for i1 in range(1, (1 + (n + -1))) {
    for i2 in range(0, (0 + 1)) {
      for i3 in range(i0, (i0 + 1)) {
        for i4 in range((i1 + -1), ((i1 + -1) + 1)) {
          b[i3][i4] = (a[(i3 - 1)][(i4 + 1)] + b[(i3 - 1)][i4]);
        }
      }
    }
    for i2 in range(1, (1 + 1)) {
      for i3 in range(i0, (i0 + 1)) {
        for i4 in range(i1, (i1 + 1)) {
          a[i3][i4] = (b[i3][(i4 - 1)] + a[i3][(i4 - 1)]);
        }
      }
    }
  }
  for i1 in range(n, (n + 1)) {
    for i2 in range(0, (0 + 1)) {
      for i3 in range(i0, (i0 + 1)) {
        for i4 in range((i1 + -1), ((i1 + -1) + 1)) {
          b[i3][i4] = (a[(i3 - 1)][(i4 + 1)] + b[(i3 - 1)][i4]);
        }
      }
    }
  }
}
