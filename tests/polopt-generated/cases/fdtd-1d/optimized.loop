context(T, N);

if (2 <= N) {
  for i0 in range(1, (T + 1)) {
    for i2 in range(1, N) {
      e[i2] = (e[i2] - (coeff1 * (h[i2] - h[(i2 - 1)])));
    }
    for i2 in range(0, N) {
      h[i2] = (h[i2] - (coeff2 * (e[(i2 + 1)] - e[i2])));
    }
  }
}
if ((N <= 1 && 1 <= N)) {
  for i0 in range(1, (T + 1)) {
    h[0] = (h[0] - (coeff2 * (e[(0 + 1)] - e[0])));
  }
}
