context(T, N);

if ((-1 * N) <= -2) {
  for i0 in range(1, (1 + T)) {
    for i1 in range(0, (0 + 1)) {
      for i2 in range(1, (1 + (N + -1))) {
        for i3 in range(i0, (i0 + 1)) {
          for i4 in range(i2, (i2 + 1)) {
            for i5 in range(0, (0 + 1)) {
              for i6 in range(0, (0 + 1)) {
                e[i4] = (e[i4] - (coeff1 * (h[i4] - h[(i4 - 1)])));
              }
            }
          }
        }
      }
    }
    for i1 in range(1, (1 + 1)) {
      for i2 in range(0, (1 + (N + -1))) {
        for i3 in range(i0, (i0 + 1)) {
          for i4 in range(i2, (i2 + 1)) {
            for i5 in range(0, (0 + 1)) {
              for i6 in range(0, (0 + 1)) {
                h[i4] = (h[i4] - (coeff2 * (e[(i4 + 1)] - e[i4])));
              }
            }
          }
        }
      }
    }
  }
}
if ((N <= 1 && (-1 * N) <= -1)) {
  for i0 in range(1, (1 + T)) {
    for i1 in range(1, (1 + 1)) {
      for i2 in range(0, (0 + 1)) {
        for i3 in range(i0, (i0 + 1)) {
          for i4 in range(0, (0 + 1)) {
            for i5 in range(0, (0 + 1)) {
              for i6 in range(0, (0 + 1)) {
                h[i4] = (h[i4] - (coeff2 * (e[(i4 + 1)] - e[i4])));
              }
            }
          }
        }
      }
    }
  }
}
