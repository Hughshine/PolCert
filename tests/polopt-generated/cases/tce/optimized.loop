context(N);

for i0 in range(0, N) {
  for i1 in range(0, N) {
    for i3 in range(0, N) {
      for i4 in range(0, N) {
        for i7 in range(0, N) {
          T1[i0][i3][i4][i1] = (T1[i0][i3][i4][i1] + (A[i7][i3][i4][i1] * C4[i7][i0]));
        }
        for i7 in range(0, N) {
          T2[i0][i7][i4][i1] = (T2[i0][i7][i4][i1] + (T1[i0][i3][i4][i1] * C3[i3][i7]));
        }
      }
    }
    for i3 in range(0, N) {
      for i4 in range(0, N) {
        for i7 in range(0, N) {
          T3[i0][i3][i4][i1] = (T3[i0][i3][i4][i1] + (T2[i0][i3][i7][i1] * C2[i7][i4]));
        }
        for i7 in range(0, N) {
          B[i0][i3][i4][i7] = (B[i0][i3][i4][i7] + (T3[i0][i3][i4][i1] * C1[i1][i7]));
        }
      }
    }
  }
}
