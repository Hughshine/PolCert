context(N);

if (1 <= N) {
  for i1 in range(0, N) {
    for i2 in range(0, N) {
      for i3 in range(0, N) {
        for i4 in range(0, N) {
          for i5 in range(0, N) {
            T1[i1][i2][i3][i4] = (T1[i1][i2][i3][i4] + (A[i5][i2][i3][i4] * C4[i5][i1]));
          }
        }
      }
    }
  }
}
if (1 <= N) {
  for i1 in range(0, N) {
    for i2 in range(0, N) {
      for i3 in range(0, N) {
        for i4 in range(0, N) {
          for i5 in range(0, N) {
            T2[i1][i2][i3][i4] = (T2[i1][i2][i3][i4] + (T1[i1][i5][i3][i4] * C3[i5][i2]));
          }
        }
      }
    }
  }
}
if (1 <= N) {
  for i1 in range(0, N) {
    for i2 in range(0, N) {
      for i3 in range(0, N) {
        for i4 in range(0, N) {
          for i5 in range(0, N) {
            T3[i1][i2][i3][i4] = (T3[i1][i2][i3][i4] + (T2[i1][i2][i5][i4] * C2[i5][i3]));
          }
        }
      }
    }
  }
}
if (1 <= N) {
  for i1 in range(0, N) {
    for i2 in range(0, N) {
      for i3 in range(0, N) {
        for i4 in range(0, N) {
          for i5 in range(0, N) {
