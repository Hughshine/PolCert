context(M, N);

if (2 <= M) {
  for i0 in range(0, ((M + 31) / 32)) {
    for i1 in range(max((((32 * i0) + 1) / 32), 0), ((M + 32) / 32)) {
      for i2 in range(max((32 * i0), 1), min(min(((32 * i0) + 32), ((32 * i1) + 31)), M)) {
        for i3 in range(max((32 * i1), (i2 + 1)), min(((32 * i1) + 32), (M + 1))) {
          symmat[i2][i3] = 0.0;
        }
      }
    }
  }
}
if ((1 <= N && 2 <= M)) {
  for i0 in range(0, ((N + 32) / 32)) {
    for i1 in range(0, ((M + 31) / 32)) {
      for i2 in range(max((((32 * i1) + 1) / 32), 0), ((M + 32) / 32)) {
        for i3 in range(max(1, (32 * i0)), min((N + 1), ((32 * i0) + 32))) {
          for i4 in range(max(1, (32 * i1)), min(min(((32 * i1) + 32), ((32 * i2) + 31)), M)) {
            for i5 in range(max((i4 + 1), (32 * i2)), min((M + 1), ((32 * i2) + 32))) {
              symmat[i4][i5] = (symmat[i4][i5] + (data[i3][i4] * data[i3][i5]));
            }
          }
        }
      }
    }
  }
}
if (2 <= M) {
  for i0 in range(0, ((M + 31) / 32)) {
    for i1 in range(max((((32 * i0) + 1) / 32), 0), ((M + 32) / 32)) {
      for i2 in range(max((32 * i0), 1), min(min(((32 * i0) + 32), ((32 * i1) + 31)), M)) {
        for i3 in range(max((32 * i1), (i2 + 1)), min(((32 * i1) + 32), (M + 1))) {
          symmat[i3][i2] = symmat[i2][i3];
        }
      }
    }
  }
}
if (2 <= M) {
  for i0 in range(0, ((M + 31) / 32)) {
    for i1 in range(max(1, (32 * i0)), min(M, ((32 * i0) + 32))) {
      symmat[i1][i1] = 1.0;
    }
  }
}
