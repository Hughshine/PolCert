context(N);

if (2 <= N) {
  for i0 in range(0, ((N + 31) / 32)) {
    for i1 in range(0, ((N + 31) / 32)) {
      for i2 in range(max((32 * i0), 1), min(((32 * i0) + 32), N)) {
        for i3 in range(max((32 * i1), 1), min(((32 * i1) + 32), N)) {
          a[i2][i3] = (a[(i2 - 1)][i3] + a[i2][(i3 - 1)]);
        }
      }
    }
  }
}
