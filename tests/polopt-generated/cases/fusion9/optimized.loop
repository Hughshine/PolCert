context(N);

if ((-1 * N) <= -2) {
  for i0 in range(0, (1 + (N + -1))) {
    for i1 in range(0, (0 + 1)) {
      for i2 in range(0, (0 + 1)) {
        for i3 in range(i0, (i0 + 1)) {
          for i4 in range(0, (0 + 1)) {
            a[(2 * i3)] = (a[(2 * i3)] + b[i4]);
          }
        }
      }
      for i2 in range(1, (1 + (N + -1))) {
        for i3 in range(i0, (i0 + 1)) {
          for i4 in range(i2, (i2 + 1)) {
            a[(2 * i3)] = (a[(2 * i3)] + b[i4]);
            a[((2 * i3) + 1)] = (a[((2 * i3) + 1)] + b[i4]);
          }
        }
      }
    }
  }
}
if ((N <= 1 && (-1 * N) <= -1)) {
  for i0 in range(0, (0 + 1)) {
    for i1 in range(0, (0 + 1)) {
      for i2 in range(0, (0 + 1)) {
        for i3 in range(0, (0 + 1)) {
          for i4 in range(0, (0 + 1)) {
            a[(2 * i3)] = (a[(2 * i3)] + b[i4]);
          }
        }
      }
    }
  }
}
