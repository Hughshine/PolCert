context(NMAX);

for i0 in range(1, (1 + (NMAX + -1))) {
  for i1 in range(0, (1 + (NMAX + -1))) {
    for i2 in range(0, (1 + (i0 + -1))) {
      for i3 in range(i0, (i0 + 1)) {
        for i4 in range(i1, (i1 + 1)) {
          for i5 in range(i2, (i2 + 1)) {
            b[i4][i5] = (b[i4][i5] + (a[i3][i5] * b[i4][i3]));
          }
        }
      }
    }
  }
}
