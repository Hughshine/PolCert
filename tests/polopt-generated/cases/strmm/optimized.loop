          for i4 in range(max(0, (32 * i1)), min(NMAX, ((32 * i1) + 32))) {
            for i5 in range(max(0, (32 * i2)), min(i3, ((32 * i2) + 32))) {
              b[i4][i5] = (b[i4][i5] + (a[i3][i5] * b[i4][i3]));
            }
