context(n);

if ((-2 * n) <= -2) {
  for i1 in range(((-1 * n) + 4), (n + 3)) {
    for i2 in range(((-1 * n) + 4), (n + 3)) {
      a[i1][i2] = (a[(i1 - 1)][i2] + 2);
    }
  }
}
if ((-2 * n) <= -2) {
  for i1 in range(((-1 * n) + 4), (n + 3)) {
    for i2 in range(((-1 * n) + 4), (n + 3)) {
      a[i1][i2] = (a[i1][i2] + 1);
    }
  }
}
