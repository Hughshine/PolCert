context(n);

if ((-2 * n) <= -2) {
  for i0 in range(0, (0 + 1)) {
    for i1 in range(((-1 * n) + 4), (1 + (n + 2))) {
      for i2 in range(((-1 * n) + 4), (1 + (n + 2))) {
        for i3 in range(i1, (i1 + 1)) {
          for i4 in range(i2, (i2 + 1)) {
            a[i3][i4] = (a[(i3 - 1)][i4] + 2);
          }
        }
      }
    }
  }
}
if ((-2 * n) <= -2) {
  for i0 in range(1, (1 + 1)) {
    for i1 in range(((-1 * n) + 4), (1 + (n + 2))) {
      for i2 in range(((-1 * n) + 4), (1 + (n + 2))) {
        for i3 in range(i1, (i1 + 1)) {
          for i4 in range(i2, (i2 + 1)) {
            a[i3][i4] = (a[i3][i4] + 1);
          }
        }
      }
    }
  }
}
