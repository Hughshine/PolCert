context(N);

if (1 <= N) {
  for i1 in range(0, N) {
    for i2 in range(0, N) {
      for i3 in range(0, N) {
        sum[i1][i2][i3] = 0;
      }
    }
  }
}
if (1 <= N) {
  for i1 in range(0, N) {
    for i2 in range(0, N) {
      for i3 in range(0, N) {
        for i4 in range(0, N) {
          sum[i1][i2][i3] = (sum[i1][i2][i3] + (A[i1][i2][i4] * C4[i4][i3]));
        }
      }
    }
  }
}
if (1 <= N) {
  for i1 in range(0, N) {
    for i2 in range(0, N) {
      for i3 in range(0, N) {
        A[i1][i2][i3] = sum[i1][i2][i3];
      }
    }
  }
}
