context(N);

for i0 in range(0, (1 + (N + -1))) {
  for i1 in range(0, (1 + (N + -1))) {
    for i2 in range(0, (0 + 1)) {
      for i3 in range(0, (1 + (N + -1))) {
        for i4 in range(0, (0 + 1)) {
          for i5 in range(0, (0 + 1)) {
            for i6 in range(i0, (i0 + 1)) {
              for i7 in range(i1, (i1 + 1)) {
                for i8 in range(i3, (i3 + 1)) {
                  for i9 in range(0, (0 + 1)) {
                    sum[i6][i7][i8] = 0;
                  }
                }
              }
            }
          }
        }
      }
    }
    for i2 in range(1, (1 + 1)) {
      for i3 in range(0, (1 + (N + -1))) {
        for i4 in range(0, (0 + 1)) {
          for i5 in range(0, (0 + 1)) {
            for i6 in range(i0, (i0 + 1)) {
              for i7 in range(i1, (i1 + 1)) {
                for i8 in range(i3, (i3 + 1)) {
                  for i9 in range(0, (0 + 1)) {
                    sum[i6][i7][i8] = (sum[i6][i7][i8] + (A[i6][i7][i9] * C4[i9][i8]));
                    A[i6][i7][i8] = sum[i6][i7][i8];
                  }
                }
              }
            }
          }
          for i5 in range(1, (1 + (N + -1))) {
            for i6 in range(i0, (i0 + 1)) {
              for i7 in range(i1, (i1 + 1)) {
                for i8 in range(i3, (i3 + 1)) {
                  for i9 in range(i5, (i5 + 1)) {
                    sum[i6][i7][i8] = (sum[i6][i7][i8] + (A[i6][i7][i9] * C4[i9][i8]));
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
