context(T, N);

if (2 <= N) {
  for i0 in range(0, T) {
    for i1 in range((i0 + 1), (N + i0)) {
      B[0][(i1 + (-1 * i0))] = (B[0][(i1 + (-1 * i0))] - ((A[0][(i1 + (-1 * i0))] * A[0][(i1 + (-1 * i0))]) / B[0][((i1 + (-1 * i0)) - 1)]));
      X[0][(i1 + (-1 * i0))] = (X[0][(i1 + (-1 * i0))] - ((X[0][((i1 + (-1 * i0)) - 1)] * A[0][(i1 + (-1 * i0))]) / B[0][((i1 + (-1 * i0)) - 1)]));
    }
    for i1 in range((i0 + 1), (N + i0)) {
      for i2 in range((i0 + 1), (N + i0)) {
        B[(i1 + (-1 * i0))][(i2 + (-1 * i0))] = (B[(i1 + (-1 * i0))][(i2 + (-1 * i0))] - ((A[(i1 + (-1 * i0))][(i2 + (-1 * i0))] * A[(i1 + (-1 * i0))][(i2 + (-1 * i0))]) / B[(i1 + (-1 * i0))][((i2 + (-1 * i0)) - 1)]));
        X[(i1 + (-1 * i0))][(i2 + (-1 * i0))] = (X[(i1 + (-1 * i0))][(i2 + (-1 * i0))] - ((X[(i1 + (-1 * i0))][((i2 + (-1 * i0)) - 1)] * A[(i1 + (-1 * i0))][(i2 + (-1 * i0))]) / B[(i1 + (-1 * i0))][((i2 + (-1 * i0)) - 1)]));
        B[(i1 + (-1 * i0))][((i2 + -1) + (-1 * i0))] = (B[(i1 + (-1 * i0))][((i2 + -1) + (-1 * i0))] - ((A[(i1 + (-1 * i0))][((i2 + -1) + (-1 * i0))] * A[(i1 + (-1 * i0))][((i2 + -1) + (-1 * i0))]) / B[((i1 + (-1 * i0)) - 1)][((i2 + -1) + (-1 * i0))]));
        X[(i1 + (-1 * i0))][((i2 + -1) + (-1 * i0))] = (X[(i1 + (-1 * i0))][((i2 + -1) + (-1 * i0))] - ((X[((i1 + (-1 * i0)) - 1)][((i2 + -1) + (-1 * i0))] * A[(i1 + (-1 * i0))][((i2 + -1) + (-1 * i0))]) / B[((i1 + (-1 * i0)) - 1)][((i2 + -1) + (-1 * i0))]));
      }
      B[(i1 + (-1 * (((-1 * N) + N) + i0)))][(N + -1)] = (B[(i1 + (-1 * (((-1 * N) + N) + i0)))][(N + -1)] - ((A[(i1 + (-1 * (((-1 * N) + N) + i0)))][(N + -1)] * A[(i1 + (-1 * (((-1 * N) + N) + i0)))][(N + -1)]) / B[((i1 + (-1 * (((-1 * N) + N) + i0))) - 1)][(N + -1)]));
      X[(i1 + (-1 * (((-1 * N) + N) + i0)))][(N + -1)] = (X[(i1 + (-1 * (((-1 * N) + N) + i0)))][(N + -1)] - ((X[((i1 + (-1 * (((-1 * N) + N) + i0))) - 1)][(N + -1)] * A[(i1 + (-1 * (((-1 * N) + N) + i0)))][(N + -1)]) / B[((i1 + (-1 * (((-1 * N) + N) + i0))) - 1)][(N + -1)]));
    }
  }
}
