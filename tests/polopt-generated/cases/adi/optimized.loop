context(T, N);

if ((-1 * N) <= -2) {
  for i0 in range(0, (1 + (T + -1))) {
    for i1 in range(0, (0 + 1)) {
      for i2 in range(0, (0 + 1)) {
        for i3 in range(1, (1 + (N + -1))) {
          for i4 in range(0, (0 + 1)) {
            for i5 in range(i0, (i0 + 1)) {
              for i6 in range(0, (0 + 1)) {
                for i7 in range(i3, (i3 + 1)) {
                  X[i6][i7] = (X[i6][i7] - ((X[i6][(i7 - 1)] * A[i6][i7]) * B[i6][(i7 - 1)]));
                  B[i6][i7] = (B[i6][i7] - ((A[i6][i7] * A[i6][i7]) * B[i6][(i7 - 1)]));
                }
              }
            }
          }
        }
      }
      for i2 in range(1, (1 + (N + -1))) {
        for i3 in range(0, (0 + 1)) {
          for i4 in range(1, (1 + 1)) {
            for i5 in range(i0, (i0 + 1)) {
              for i6 in range(i2, (i2 + 1)) {
                for i7 in range(0, (0 + 1)) {
                  B[i6][i7] = (B[i6][i7] - ((A[i6][i7] * A[i6][i7]) * B[(i6 - 1)][i7]));
                }
              }
            }
          }
        }
        for i3 in range(1, (1 + (N + -1))) {
          for i4 in range(0, (0 + 1)) {
            for i5 in range(i0, (i0 + 1)) {
              for i6 in range(i2, (i2 + 1)) {
                for i7 in range(i3, (i3 + 1)) {
                  X[i6][i7] = (X[i6][i7] - ((X[i6][(i7 - 1)] * A[i6][i7]) * B[i6][(i7 - 1)]));
                  B[i6][i7] = (B[i6][i7] - ((A[i6][i7] * A[i6][i7]) * B[i6][(i7 - 1)]));
                }
              }
            }
          }
          for i4 in range(1, (1 + 1)) {
            for i5 in range(i0, (i0 + 1)) {
              for i6 in range(i2, (i2 + 1)) {
                for i7 in range(i3, (i3 + 1)) {
                  B[i6][i7] = (B[i6][i7] - ((A[i6][i7] * A[i6][i7]) * B[(i6 - 1)][i7]));
                }
              }
            }
          }
        }
      }
    }
    for i1 in range(1, (1 + 1)) {
      for i2 in range(1, (1 + (N + -1))) {
        for i3 in range(0, (1 + (N + -1))) {
          for i4 in range(0, (0 + 1)) {
            for i5 in range(i0, (i0 + 1)) {
              for i6 in range(i2, (i2 + 1)) {
                for i7 in range(i3, (i3 + 1)) {
                  X[i6][i7] = (X[i6][i7] - ((X[(i6 - 1)][i7] * A[i6][i7]) * B[(i6 - 1)][i7]));
                }
              }
            }
          }
        }
      }
    }
  }
}
