context(T, N);

if (2 <= N) {
  for i0 in range(0, T) {
    for i2 in range(0, N) {
      for i3 in range(1, N) {
        X[i2][i3] = (X[i2][i3] - ((X[i2][(i3 - 1)] * A[i2][i3]) / B[i2][(i3 - 1)]));
        B[i2][i3] = (B[i2][i3] - ((A[i2][i3] * A[i2][i3]) / B[i2][(i3 - 1)]));
      }
    }
    for i2 in range(1, N) {
      for i3 in range(0, N) {
        X[i2][i3] = (X[i2][i3] - ((X[(i2 - 1)][i3] * A[i2][i3]) / B[(i2 - 1)][i3]));
        B[i2][i3] = (B[i2][i3] - ((A[i2][i3] * A[i2][i3]) / B[(i2 - 1)][i3]));
      }
    }
  }
}
