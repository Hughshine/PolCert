context(m, n);

if (1 <= m) {
  for i1 in range(1, (m + 1)) {
    stddev[i1] = 0.0;
    mean[i1] = 0.0;
  }
}
if ((1 <= m && 1 <= n)) {
  for i1 in range(1, (m + 1)) {
    for i2 in range(1, (n + 1)) {
      mean[i1] = (mean[i1] + data[i2][i1]);
    }
  }
}
if (1 <= m) {
  for i1 in range(1, (m + 1)) {
    mean[i1] = (mean[i1] / float_n);
  }
}
if ((1 <= n && 1 <= m)) {
  for i1 in range(1, (m + 1)) {
    for i2 in range(1, (n + 1)) {
      stddev[i1] = (stddev[i1] + ((data[i2][i1] - mean[i1]) * (data[i2][i1] - mean[i1])));
    }
  }
}
if (1 <= m) {
  for i1 in range(1, (m + 1)) {
    stddev[i1] = (stddev[i1] / float_n);
    stddev[i1] = my_sqrt_array(stddev, i1);
    stddev[i1] = ((stddev[i1] <= eps) ? 1.0 : stddev[i1]);
  }
}
