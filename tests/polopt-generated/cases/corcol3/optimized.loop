context(m, n);

if (1 <= m) {
  for i0 in range(1, (m + 1)) {
    stddev[i0] = 0.0;
    mean[i0] = 0.0;
  }
}
if ((1 <= m && 1 <= n)) {
  for i0 in range(1, (m + 1)) {
    for i1 in range(1, (n + 1)) {
      mean[i0] = (mean[i0] + data[i1][i0]);
    }
  }
}
if (1 <= m) {
  for i0 in range(1, (m + 1)) {
    mean[i0] = (mean[i0] / float_n);
  }
}
if ((1 <= n && 1 <= m)) {
  for i0 in range(1, (m + 1)) {
    for i1 in range(1, (n + 1)) {
      stddev[i0] = (stddev[i0] + ((data[i1][i0] - mean[i0]) * (data[i1][i0] - mean[i0])));
    }
  }
}
if (1 <= m) {
  for i0 in range(1, (m + 1)) {
    stddev[i0] = (stddev[i0] / float_n);
    stddev[i0] = my_sqrt_array(stddev, i0);
    stddev[i0] = ((stddev[i0] <= eps) ? 1.0 : stddev[i0]);
  }
}
