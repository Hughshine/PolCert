        for i3 in range(0, (0 + 1)) {
          for i4 in range(0, (0 + 1)) {
            for i5 in range(i1, (i1 + 1)) {
              for i6 in range(i2, (i2 + 1)) {
                for i7 in range(0, (0 + 1)) {
                  for i8 in range(0, (0 + 1)) {
                    temp2d[i5][i6] = 0;
                    block[i5][i6] = sum2[i5][i6];
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
if ((-1 * M) <= -1) {
  for i0 in range(1, (1 + 1)) {
    for i1 in range(0, (1 + (M + -1))) {
      for i2 in range(0, (1 + (M + -1))) {
        for i3 in range(0, (0 + 1)) {
          for i4 in range(0, (0 + 1)) {
            for i5 in range(i1, (i1 + 1)) {
              for i6 in range(i2, (i2 + 1)) {
                for i7 in range(0, (0 + 1)) {
                  for i8 in range(0, (0 + 1)) {
                    temp2d[i5][i6] = (temp2d[i5][i6] + (block[i5][i7] * cos1[i6][i7]));
                    sum2[i5][i6] = 0;
                  }
                }
              }
            }
          }
          for i4 in range(1, (1 + (M + -1))) {
            for i5 in range(i1, (i1 + 1)) {
              for i6 in range(i2, (i2 + 1)) {
                for i7 in range(i4, (i4 + 1)) {
                  for i8 in range(0, (0 + 1)) {
                    temp2d[i5][i6] = (temp2d[i5][i6] + (block[i5][i7] * cos1[i6][i7]));
                  }
                }
              }
            }
          }
        }
        for i3 in range(1, (1 + 1)) {
          for i4 in range(0, (1 + (M + -1))) {
            for i5 in range(i1, (i1 + 1)) {
              for i6 in range(i2, (i2 + 1)) {
                for i7 in range(i4, (i4 + 1)) {
                  for i8 in range(0, (0 + 1)) {
                    sum2[i5][i6] = (sum2[i5][i6] + (cos1[i5][i7] * temp2d[i7][i6]));
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
