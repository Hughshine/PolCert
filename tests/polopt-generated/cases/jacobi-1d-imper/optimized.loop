context(T, N);

if (4 <= N) {
  for i0 in range(0, T) {
    b[2] = (0.33333 * ((a[(2 - 1)] + a[2]) + a[(2 + 1)]));
    for i1 in range(((2 * i0) + 3), ((N + -1) + (2 * i0))) {
      b[((-2 * i0) + i1)] = (0.33333 * ((a[(((-2 * i0) + i1) - 1)] + a[((-2 * i0) + i1)]) + a[(((-2 * i0) + i1) + 1)]));
      a[(((-2 * i0) + -1) + i1)] = b[(((-2 * i0) + -1) + i1)];
    }
    a[(N + -2)] = b[(N + -2)];
  }
}
