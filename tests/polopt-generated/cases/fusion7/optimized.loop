context(N, M);

if ((-1 * N) <= -1) {
  for i0 in range(0, (0 + 1)) {
    for i1 in range(0, (1 + (N + -1))) {
      for i2 in range(i1, (i1 + 1)) {
        for i3 in range(0, (0 + 1)) {
          a[i2] = b[i2];
        }
      }
    }
  }
}
if ((-1 * M) <= -1) {
  for i0 in range(1, (1 + 1)) {
    for i1 in range(0, (1 + (M + -1))) {
      for i2 in range(i1, (i1 + 1)) {
        for i3 in range(0, (0 + 1)) {
          a[i2] = b[i2];
        }
      }
    }
  }
}
