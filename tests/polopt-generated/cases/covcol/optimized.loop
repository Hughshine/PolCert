context(M, N);

if ((1 <= N && 1 <= M)) {
  for i1 in range(1, (N + 1)) {
    for i2 in range(1, (M + 1)) {
      for i3 in range(i2, (M + 1)) {
        symmat[i2][i3] = (symmat[i2][i3] + (data[i1][i2] * data[i1][i3]));
      }
    }
  }
}
if (1 <= M) {
  for i1 in range(1, (M + 1)) {
    for i2 in range(i1, (M + 1)) {
      symmat[i2][i1] = symmat[i1][i2];
    }
  }
}
