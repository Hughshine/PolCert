context(m, n);

for i0 in range(1, (m + 1)) {
  mean[i0] = 0;
  for i1 in range(1, (n + 1)) {
    mean[i0] = (mean[i0] + data[i1][i0]);
  }
  mean[i0] = (mean[i0] * float_n);
}
for i0 in range(1, (m + 1)) {
  stddev[i0] = 0;
  for i1 in range(1, (n + 1)) {
    stddev[i0] = (stddev[i0] + ((data[i1][i0] - mean[i0]) * (data[i1][i0] - mean[i0])));
  }
  stddev[i0] = (stddev[i0] * float_n);
  stddev[i0] = stddev[i0];
  stddev[i0] = ((stddev[i0] + eps) + stddev[i0]);
}
for i0 in range(1, (n + 1)) {
  for i1 in range(1, (m + 1)) {
    data[i0][i1] = (data[i0][i1] - mean[i1]);
    x = float_n;
    x = (x * stddev[i1]);
    data[i0][i1] = (data[i0][i1] * x);
  }
}
for i0 in range(1, ((m + -1) + 1)) {
  symmat[i0][i0] = 1;
  for i1 in range((i0 + 1), (m + 1)) {
    symmat[i0][i1] = 0;
    for i2 in range(1, (n + 1)) {
      symmat[i0][i1] = (symmat[i0][i1] + (data[i2][i0] * data[i2][i1]));
    }
    symmat[i1][i0] = symmat[i0][i1];
  }
}
