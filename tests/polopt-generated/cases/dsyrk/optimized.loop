context(NMAX);

if (1 <= NMAX) {
  for i0 in range(0, ((NMAX + 31) / 32)) {
    for i1 in range(0, ((NMAX + 31) / 32)) {
      for i2 in range(max(0, ((32 * i1) / 32)), ((NMAX + 31) / 32)) {
        for i3 in range(max(0, (32 * i0)), min(NMAX, ((32 * i0) + 32))) {
          for i4 in range(max(0, (32 * i1)), min(min(((32 * i1) + 32), ((32 * i2) + 32)), NMAX)) {
            for i5 in range(max(i4, (32 * i2)), min(NMAX, ((32 * i2) + 32))) {
              c[i4][i5] = (c[i4][i5] + (a[i3][i4] * a[i3][i5]));
            }
          }
        }
      }
    }
  }
}
