context(N);

if ((-1 * N) <= -2) {
  for i0 in range(0, (1 + (N + -1))) {
    for i1 in range(0, (0 + 1)) {
      for i2 in range(0, (0 + 1)) {
        for i3 in range(0, (0 + 1)) {
          for i4 in range(i0, (i0 + 1)) {
            for i5 in range(0, (0 + 1)) {
              for i6 in range(0, (0 + 1)) {
                B[i5][i4] = (B[i5][i4] * L[i5][i5]);
              }
            }
          }
        }
      }
    }
    for i1 in range(1, (1 + (N + -1))) {
      for i2 in range(0, (0 + 1)) {
        for i3 in range(0, (0 + 1)) {
          for i4 in range(i0, (i0 + 1)) {
            for i5 in range(i1, (i1 + 1)) {
              for i6 in range(0, (0 + 1)) {
                B[i5][i4] = (B[i5][i4] - (L[i5][i6] * B[i6][i4]));
                B[i5][i4] = (B[i5][i4] * L[i5][i5]);
              }
            }
          }
        }
        for i3 in range(1, (1 + (i1 + -1))) {
          for i4 in range(i0, (i0 + 1)) {
            for i5 in range(i1, (i1 + 1)) {
              for i6 in range(i3, (i3 + 1)) {
                B[i5][i4] = (B[i5][i4] - (L[i5][i6] * B[i6][i4]));
              }
            }
          }
        }
      }
    }
  }
}
if ((N <= 1 && (-1 * N) <= -1)) {
  for i0 in range(0, (0 + 1)) {
    for i1 in range(0, (0 + 1)) {
      for i2 in range(0, (0 + 1)) {
        for i3 in range(0, (0 + 1)) {
          for i4 in range(0, (0 + 1)) {
            for i5 in range(0, (0 + 1)) {
              for i6 in range(0, (0 + 1)) {
                B[i5][i4] = (B[i5][i4] * L[i5][i5]);
              }
            }
          }
        }
      }
    }
  }
}
