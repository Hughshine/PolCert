context(N);

if (2 <= N) {
  for i0 in range(0, N) {
    B[0][i0] = (B[0][i0] / L[0][0]);
    for i1 in range(1, N) {
      for i3 in range(0, i1) {
        B[i1][i0] = (B[i1][i0] - (L[i1][i3] * B[i3][i0]));
      }
      B[i1][i0] = (B[i1][i0] / L[i1][i1]);
    }
  }
}
if ((N <= 1 && 1 <= N)) {
  B[0][0] = (B[0][0] / L[0][0]);
}
