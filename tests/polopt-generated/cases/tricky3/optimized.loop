          for i4 in range(i0, (i0 + 1)) {
            for i5 in range(i2, (i2 + 1)) {
              for i6 in range(0, (0 + 1)) {
                for i7 in range(0, (0 + 1)) {
                  dist = 0;
                }
              }
            }
          }
        }
      }
    }
    for i1 in range(2, (2 + 1)) {
      for i2 in range(0, (1 + (dims + -1))) {
        for i3 in range(0, (0 + 1)) {
          for i4 in range(i0, (i0 + 1)) {
            for i5 in range(i2, (i2 + 1)) {
              for i6 in range(0, (0 + 1)) {
                for i7 in range(0, (0 + 1)) {
                  clusterv = 0;
                }
              }
            }
          }
        }
      }
    }
  }
}
if ((clusterc <= 0 && (-1 * dims) <= -1)) {
  for i0 in range(0, (1 + (pointc + -1))) {
