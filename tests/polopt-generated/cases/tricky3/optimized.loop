                for i7 in range(0, (0 + 1)) {
                  dist_min = 0;
                }
              }
            }
          }
        }
        for i3 in range(1, (1 + 1)) {
          for i4 in range(i0, (i0 + 1)) {
            for i5 in range(0, (0 + 1)) {
              for i6 in range(0, (0 + 1)) {
                for i7 in range(0, (0 + 1)) {
