context(N);

for i0 in range(1, (1 + ((2 * N) + -2))) {
  for i1 in range(max((((-1 * N) + i0) + 1), 0), min((1 + (i0 + -1)), (1 + (N + -1)))) {
    for i2 in range(i1, (i1 + 1)) {
      for i3 in range((i0 + (-1 * i1)), ((i0 + (-1 * i1)) + 1)) {
        a[i2][i3] = (a[i3][i2] + a[i2][(i3 - 1)]);
      }
    }
  }
}
