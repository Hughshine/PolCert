context(n);

if ((-2 * n) <= -1) {
  for i1 in range(0, (2 * n)) {
    c[i1] = 0;
  }
}
if (1 <= n) {
  for i1 in range(0, n) {
    for i2 in range(i1, (n + i1)) {
      for i4 in range((i2 + (-1 * i1)), ((i2 + 1) + (-1 * i1))) {
        c[(i1 + i4)] = (c[(i1 + i4)] + (a[i1] * b[i4]));
      }
    }
  }
}
