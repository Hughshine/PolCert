context(n);

if ((-2 * n) <= -1) {
  for i0 in range(0, (2 * n)) {
    c[i0] = 0;
  }
}
if (1 <= n) {
  for i0 in range(0, n) {
    for i1 in range(i0, (n + i0)) {
      for i2 in range((i1 + (-1 * i0)), (i1 + ((-1 * i0) + 1))) {
        c[(i0 + i2)] = (c[(i0 + i2)] + (a[i0] * b[i2]));
      }
    }
  }
}
