context(N);

for i0 in range(0, N) {
  for i1 in range(0, N) {
    for i2 in range(0, N) {
      C[i0][i1] = (C[i0][i1] + (A[i0][i2] * B[i2][i1]));
      F[i0][i1] = (F[i0][i1] + (D[i0][i2] * E[i2][i1]));
    }
    for i2 in range(0, min((i1 + 1), (i0 + 1))) {
      G[(i0 + (-1 * i2))][(i1 + (-1 * i2))] = (G[(i0 + (-1 * i2))][(i1 + (-1 * i2))] + (C[(i0 + (-1 * i2))][i2] * F[i2][(i1 + (-1 * i2))]));
    }
  }
  for i1 in range(N, (N + i0)) {
    for i2 in range((((-1 * N) + 1) + i1), (i0 + 1)) {
      G[(i0 + (-1 * i2))][(i1 + (-1 * i2))] = (G[(i0 + (-1 * i2))][(i1 + (-1 * i2))] + (C[(i0 + (-1 * i2))][i2] * F[i2][(i1 + (-1 * i2))]));
    }
  }
}
for i0 in range(N, ((2 * N) + -1)) {
  for i1 in range((((-1 * N) + 1) + i0), ((2 * N) + -1)) {
    for i2 in range(max((((-1 * N) + 1) + i1), (((-1 * N) + 1) + i0)), min((i1 + 1), N)) {
      G[(i0 + (-1 * i2))][(i1 + (-1 * i2))] = (G[(i0 + (-1 * i2))][(i1 + (-1 * i2))] + (C[(i0 + (-1 * i2))][i2] * F[i2][(i1 + (-1 * i2))]));
    }
  }
}
