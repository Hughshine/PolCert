context(N);

for i0 in range(0, N) {
  for i1 in range(0, N) {
    for i2 in range(0, N) {
      C[i0][i1] = (C[i0][i1] + (A[i0][i2] * B[i2][i1]));
      F[i0][i1] = (F[i0][i1] + (D[i0][i2] * E[i2][i1]));
    }
    for i2 in range(0, min((i1 + 1), (i0 + 1))) {
      for i3 in range((i0 + (-1 * i2)), (i0 + ((-1 * i2) + 1))) {
        for i4 in range((i1 + (-1 * i2)), (i1 + ((-1 * i2) + 1))) {
          G[i3][i4] = (G[i3][i4] + (C[i3][i2] * F[i2][i4]));
        }
      }
    }
  }
  for i1 in range(N, (N + i0)) {
    for i2 in range(((-1 * N) + (i1 + 1)), (i0 + 1)) {
      for i3 in range((i0 + (-1 * i2)), (i0 + ((-1 * i2) + 1))) {
        for i4 in range((i1 + (-1 * i2)), (i1 + ((-1 * i2) + 1))) {
          G[i3][i4] = (G[i3][i4] + (C[i3][i2] * F[i2][i4]));
        }
      }
    }
  }
}
for i0 in range(N, ((2 * N) + -1)) {
  for i1 in range(((-1 * N) + (i0 + 1)), ((2 * N) + -1)) {
    for i2 in range(max(((-1 * N) + (i1 + 1)), ((-1 * N) + (i0 + 1))), min((i1 + 1), N)) {
      for i3 in range((i0 + (-1 * i2)), (i0 + ((-1 * i2) + 1))) {
        for i4 in range((i1 + (-1 * i2)), (i1 + ((-1 * i2) + 1))) {
          G[i3][i4] = (G[i3][i4] + (C[i3][i2] * F[i2][i4]));
        }
      }
    }
  }
}
