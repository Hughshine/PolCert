context(M, N);

if ((1 <= N && 2 <= M)) {
  for i0 in range(1, M) {
    for i1 in range((i0 + 1), (M + 1)) {
      symmat[i0][i1] = 0.0;
      for i2 in range(1, (N + 1)) {
        symmat[i0][i1] = (symmat[i0][i1] + (data[i2][i0] * data[i2][i1]));
      }
      symmat[i1][i0] = symmat[i0][i1];
    }
  }
}
if ((N <= 0 && 2 <= M)) {
  for i0 in range(1, M) {
    for i1 in range((i0 + 1), (M + 1)) {
      symmat[i0][i1] = 0.0;
      symmat[i1][i0] = symmat[i0][i1];
    }
  }
}
if (2 <= M) {
  for i0 in range(1, M) {
    symmat[i0][i0] = 1.0;
  }
}
