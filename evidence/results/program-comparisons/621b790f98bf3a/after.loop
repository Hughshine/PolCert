context(N, M, K);

if (1 <= M) {
  if (2 <= N) {
    for i0 in range(0, ((N + -1) / 2)) {
      if (1 <= M) {
        for i1 in range(0, (M / 2)) {
          A[((2 * i0) + 1)][(2 * i1)] = (A[(2 * i0)][K] + 1);
          A[((2 * i0) + 1)][((2 * i1) + 1)] = (A[(2 * i0)][K] + 1);
        }
        for i1 in range((2 * (M / 2)), M) {
          A[((2 * i0) + 1)][i1] = (A[(2 * i0)][K] + 1);
        }
      }
      if (1 <= M) {
        for i1 in range(0, (M / 2)) {
          A[((2 * i0) + 2)][(2 * i1)] = (A[((2 * i0) + 1)][K] + 1);
          A[((2 * i0) + 2)][((2 * i1) + 1)] = (A[((2 * i0) + 1)][K] + 1);
        }
        for i1 in range((2 * (M / 2)), M) {
          A[((2 * i0) + 2)][i1] = (A[((2 * i0) + 1)][K] + 1);
        }
      }
    }
    for i0 in range(((2 * ((N + -1) / 2)) + 1), N) {
      if (1 <= M) {
        for i1 in range(0, (M / 2)) {
          A[i0][(2 * i1)] = (A[(i0 + -1)][K] + 1);
          A[i0][((2 * i1) + 1)] = (A[(i0 + -1)][K] + 1);
        }
        for i1 in range((2 * (M / 2)), M) {
          A[i0][i1] = (A[(i0 + -1)][K] + 1);
        }
      }
    }
  }
}
