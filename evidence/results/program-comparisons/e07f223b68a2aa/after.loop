context(M, N);

if (2 <= M) {
  for i0 in range(0, ((M + 31) / 32)) {
    for i1 in range(max(0, (((32 * i0) + 1) / 32)), ((M + 32) / 32)) {
      for i2 in range(max(1, (32 * i0)), min(min(M, ((32 * i1) + 31)), ((32 * i0) + 32))) {
        for i3 in range(max((i2 + 1), (32 * i1)), min((M + 1), ((32 * i1) + 32))) {
          symmat[i2][i3] = 0.0;
        }
      }
    }
  }
}
if ((1 <= N && 2 <= M)) {
  for i0 in range(0, ((M + 31) / 32)) {
