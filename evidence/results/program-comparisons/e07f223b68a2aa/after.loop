      for i2 in range(0, ((N + 32) / 32)) {
        for i3 in range(max((32 * i0), 1), min(min(((32 * i1) + 31), M), ((32 * i0) + 32))) {
          for i4 in range(max((32 * i1), (i3 + 1)), min(((32 * i1) + 32), (M + 1))) {
            for i5 in range(max(1, (32 * i2)), min((N + 1), ((32 * i2) + 32))) {
              symmat[i3][i4] = (symmat[i3][i4] + (data[i5][i3] * data[i5][i4]));
            }
          }
        }
      }
    }
  }
}
if (2 <= M) {
  for i0 in range(0, ((M + 31) / 32)) {
    for i1 in range(max(0, (((32 * i0) + 1) / 32)), ((M + 32) / 32)) {
      for i2 in range(max(1, (32 * i0)), min(min(M, ((32 * i1) + 31)), ((32 * i0) + 32))) {
        for i3 in range(max((i2 + 1), (32 * i1)), min((M + 1), ((32 * i1) + 32))) {
          symmat[i3][i2] = symmat[i2][i3];
        }
      }
    }
  }
}
if (2 <= M) {
  for i0 in range(0, ((M + 31) / 32)) {
    for i1 in range(max((32 * i0), 1), min(((32 * i0) + 32), M)) {
