context(N);

if (2 <= N) {
  for i0 in range(0, ((N + 31) / 32)) {
    for i1 in range(0, ((N + 31) / 32)) {
      for i2 in range(max(0, (32 * i0)), min(N, ((32 * i0) + 32))) {
        if (i1 <= 0) {
          B[0][i2] = (B[0][i2] / L[0][0]);
        }
        for i3 in range(max((32 * i1), 1), min(N, ((32 * i1) + 32))) {
          for i4 in range(0, i3) {
            B[i3][i2] = (B[i3][i2] - (L[i3][i4] * B[i4][i2]));
          }
          B[i3][i2] = (B[i3][i2] / L[i3][i3]);
        }
      }
    }
  }
}
if ((N <= 1 && 1 <= N)) {
  B[0][0] = (B[0][0] / L[0][0]);
}
