context(N);

if (1 <= N) {
  for i0 in range(0, (N / 4)) {
    for i1 in range(0, N) {
      y[(4 * i0)] = (y[(4 * i0)] + (a[(4 * i0)][i1] * x[i1]));
    }
    for i1 in range(0, N) {
      z[i1] = (z[i1] + (b[i1][(4 * i0)] * y[(4 * i0)]));
    }
    for i1 in range(0, N) {
      y[((4 * i0) + 1)] = (y[((4 * i0) + 1)] + (a[((4 * i0) + 1)][i1] * x[i1]));
    }
    for i1 in range(0, N) {
      z[i1] = (z[i1] + (b[i1][((4 * i0) + 1)] * y[((4 * i0) + 1)]));
    }
    for i1 in range(0, N) {
      y[((4 * i0) + 2)] = (y[((4 * i0) + 2)] + (a[((4 * i0) + 2)][i1] * x[i1]));
    }
    for i1 in range(0, N) {
      z[i1] = (z[i1] + (b[i1][((4 * i0) + 2)] * y[((4 * i0) + 2)]));
    }
    for i1 in range(0, N) {
      y[((4 * i0) + 3)] = (y[((4 * i0) + 3)] + (a[((4 * i0) + 3)][i1] * x[i1]));
    }
    for i1 in range(0, N) {
      z[i1] = (z[i1] + (b[i1][((4 * i0) + 3)] * y[((4 * i0) + 3)]));
    }
  }
  for i0 in range((4 * (N / 4)), N) {
    for i1 in range(0, N) {
      y[i0] = (y[i0] + (a[i0][i1] * x[i1]));
    }
    for i1 in range(0, N) {
      z[i1] = (z[i1] + (b[i1][i0] * y[i0]));
    }
  }
}
