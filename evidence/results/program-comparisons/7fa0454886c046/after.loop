for i0 in range(0, 100) {
  for i1 in range(0, 100) {
    A[i0][i1] = 1;
  }
}
for i0 in range(0, 100) {
  for i1 in range(i0, (i0 + 100)) {
    for i2 in range(((-1 * i0) + i1), ((-1 * i0) + (i1 + 1))) {
      for i3 in range((i1 + (-1 * i2)), (i1 + ((-1 * i2) + 1))) {
        B[i2][i3] = (A[(i2 + 1)][i3] + A[i2][(i3 + 1)]);
      }
    }
  }
}
