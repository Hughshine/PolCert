context(N);

if (1 <= N) {
  parallel for i0 in range(0, ((N + 31) / 32)) {
    parallel for i1 in range(0, ((N + 31) / 32)) {
      parallel for i2 in range(max(0, (32 * i0)), min(N, ((32 * i0) + 32))) {
        parallel for i3 in range(max(0, (32 * i1)), min(N, ((32 * i1) + 32))) {
          parallel for i4 in range(0, 1) {
            C[i2][i3] = 0;
          }
        }
      }
      for i2 in range(0, ((N + 31) / 32)) {
        parallel for i3 in range(max(0, (32 * i0)), min(N, ((32 * i0) + 32))) {
          parallel for i4 in range(max(0, (32 * i1)), min(N, ((32 * i1) + 32))) {
            parallel for i5 in range(1, 2) {
              for i6 in range(max((32 * i2), 0), min(((32 * i2) + 32), N)) {
                C[i3][i4] = (C[i3][i4] + (A[i3][i6] * B[i6][i4]));
              }
            }
          }
        }
      }
    }
  }
}
