context(T, N);

if (2 <= N) {
  for i0 in range(0, T) {
    for i1 in range(0, N) {
      for i2 in range(1, N) {
        X[i1][i2] = (X[i1][i2] - ((X[i1][(i2 + -1)] * A[i1][i2]) / B[i1][(i2 + -1)]));
        B[i1][i2] = (B[i1][i2] - ((A[i1][i2] * A[i1][i2]) / B[i1][(i2 + -1)]));
      }
    }
    for i1 in range(0, N) {
      for i2 in range(1, N) {
        X[i2][i1] = (X[i2][i1] - ((X[(i2 + -1)][i1] * A[i2][i1]) / B[(i2 + -1)][i1]));
        B[i2][i1] = (B[i2][i1] - ((A[i2][i1] * A[i2][i1]) / B[(i2 + -1)][i1]));
      }
    }
  }
}
