context(T, N);

if (2 <= N) {
  for i0 in range(1, (T + 1)) {
    if ((i0 + 2) <= (N + i0)) {
      for i1 in range(0, ((N + (i0 + (-1 * (i0 + 1)))) / 4)) {
        for i2 in range(((-1 * i0) + (i0 + ((4 * i1) + 1))), ((-1 * i0) + (i0 + ((4 * i1) + 2)))) {
          e[i2] = (e[i2] - (coeff1 * (h[i2] - h[(i2 + -1)])));
        }
        for i2 in range(((-1 * i0) + (i0 + (4 * i1))), ((-1 * i0) + (i0 + ((4 * i1) + 1)))) {
          h[i2] = (h[i2] - (coeff2 * (e[(i2 + 1)] - e[i2])));
        }
        for i2 in range(((-1 * i0) + (i0 + ((4 * i1) + 2))), ((-1 * i0) + (i0 + ((4 * i1) + 3)))) {
          e[i2] = (e[i2] - (coeff1 * (h[i2] - h[(i2 + -1)])));
        }
        for i2 in range(((-1 * i0) + (i0 + ((4 * i1) + 1))), ((-1 * i0) + (i0 + ((4 * i1) + 2)))) {
          h[i2] = (h[i2] - (coeff2 * (e[(i2 + 1)] - e[i2])));
        }
        for i2 in range(((-1 * i0) + (i0 + ((4 * i1) + 3))), ((-1 * i0) + (i0 + ((4 * i1) + 4)))) {
          e[i2] = (e[i2] - (coeff1 * (h[i2] - h[(i2 + -1)])));
        }
        for i2 in range(((-1 * i0) + (i0 + ((4 * i1) + 2))), ((-1 * i0) + (i0 + ((4 * i1) + 3)))) {
          h[i2] = (h[i2] - (coeff2 * (e[(i2 + 1)] - e[i2])));
        }
        for i2 in range(((-1 * i0) + (i0 + ((4 * i1) + 4))), ((-1 * i0) + (i0 + ((4 * i1) + 5)))) {
          e[i2] = (e[i2] - (coeff1 * (h[i2] - h[(i2 + -1)])));
        }
        for i2 in range(((-1 * i0) + (i0 + ((4 * i1) + 3))), ((-1 * i0) + (i0 + ((4 * i1) + 4)))) {
          h[i2] = (h[i2] - (coeff2 * (e[(i2 + 1)] - e[i2])));
        }
      }
      for i1 in range((i0 + ((4 * ((N + (i0 + (-1 * (i0 + 1)))) / 4)) + 1)), (N + i0)) {
        for i2 in range(((-1 * i0) + i1), ((-1 * i0) + (i1 + 1))) {
          e[i2] = (e[i2] - (coeff1 * (h[i2] - h[(i2 + -1)])));
        }
        for i2 in range(((-1 * i0) + (i1 + -1)), ((-1 * i0) + i1)) {
          h[i2] = (h[i2] - (coeff2 * (e[(i2 + 1)] - e[i2])));
        }
      }
    }
    for i1 in range((N + i0), (N + (i0 + 1))) {
      for i2 in range((N + -1), N) {
        h[i2] = (h[i2] - (coeff2 * (e[(i2 + 1)] - e[i2])));
      }
    }
  }
}
if ((N <= 1 && 1 <= N)) {
  for i0 in range(1, (T + 1)) {
    for i1 in range((i0 + 1), (i0 + 2)) {
      h[0] = (h[0] - (coeff2 * (e[1] - e[0])));
    }
  }
}
