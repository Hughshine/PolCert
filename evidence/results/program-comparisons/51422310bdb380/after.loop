context(m, n);

if (2 <= m) {
  for i0 in range(1, m) {
    for i1 in range((i0 + 1), (m + 1)) {
      symmat[i0][i1] = 0.0;
    }
  }
}
if (2 <= m) {
  for i0 in range(1, m) {
    symmat[i0][i0] = 1.0;
    stddev[i0] = 0.0;
    mean[i0] = 0.0;
  }
  stddev[m] = 0.0;
  mean[m] = 0.0;
}
if ((m <= 1 && 1 <= m)) {
  stddev[1] = 0.0;
  mean[1] = 0.0;
}
if ((1 <= m && 1 <= n)) {
  for i0 in range(1, (m + 1)) {
    for i1 in range(1, (n + 1)) {
      mean[i0] = (mean[i0] + data[i1][i0]);
    }
  }
}
if (1 <= m) {
  for i0 in range(1, (m + 1)) {
    mean[i0] = (mean[i0] / float_n);
  }
}
if ((1 <= m && 1 <= n)) {
  for i0 in range(1, (m + 1)) {
    for i1 in range(1, (n + 1)) {
      stddev[i0] = (stddev[i0] + ((data[i1][i0] - mean[i0]) * (data[i1][i0] - mean[i0])));
      data[i1][i0] = (data[i1][i0] - mean[i0]);
    }
  }
}
if (1 <= m) {
  for i0 in range(1, (m + 1)) {
    stddev[i0] = (stddev[i0] / float_n);
    stddev[i0] = sqrt(stddev[i0]);
    stddev[i0] = ((stddev[i0] <= eps) ? 1.0 : stddev[i0]);
  }
}
if ((1 <= n && 1 <= m)) {
  for i0 in range(1, (n + 1)) {
    for i1 in range(1, (m + 1)) {
      x = sqrt(float_n);
      x = (x * stddev[i1]);
      data[i0][i1] = (data[i0][i1] / x);
    }
  }
}
if ((1 <= n && 2 <= m)) {
  for i0 in range(1, (n + 1)) {
    for i1 in range(1, m) {
      for i2 in range((i1 + 1), (m + 1)) {
        symmat[i1][i2] = (symmat[i1][i2] + (data[i0][i1] * data[i0][i2]));
      }
    }
  }
}
if (2 <= m) {
  for i0 in range(1, m) {
    for i1 in range((i0 + 1), (m + 1)) {
      symmat[i1][i0] = symmat[i0][i1];
    }
  }
}
