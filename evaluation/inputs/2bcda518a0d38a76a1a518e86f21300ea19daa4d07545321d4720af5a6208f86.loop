      for i in range(0, N) {
        for j in range(0, N) {
          for k in range(0, N) {
            u[(1 - p)][i][j][k] = ((i == 0) ? u[p][(N - 1)][j][k] : u[p][(i - 1)][j][k])+ u[p][i][j][k]+ ((i == N - 1) ? u[p][(0)][j][k] : u[p][(i + 1)][j][k])+ ((i == 0) ? ((j == 0) ? u[p][(N - 1)][(N - 1)][k] : u[p][(N - 1)][(j - 1)][k]) : ((j == 0) ? u[p][(i - 1)][(N - 1)][k] : u[p][(i - 1)][(j - 1)][k]))+ ((i == N - 1) ? ((j == N - 1) ? u[p][(0)][(0)][k] : u[p][(0)][(j + 1)][k]) : ((j == N - 1) ? u[p][(i + 1)][(0)][k] : u[p][(i + 1)][(j + 1)][k]))+ ((i == 0) ? ((j == N - 1) ? u[p][(N - 1)][(0)][k] : u[p][(N - 1)][(j + 1)][k]) : ((j == N - 1) ? u[p][(i - 1)][(0)][k] : u[p][(i - 1)][(j + 1)][k]))+ ((i == N - 1) ? ((j == 0) ? u[p][(0)][(N - 1)][k] : u[p][(0)][(j - 1)][k]) : ((j == 0) ? u[p][(i + 1)][(N - 1)][k] : u[p][(i + 1)][(j - 1)][k]))+ ((j == 0) ? u[p][i][(N - 1)][k] : u[p][i][(j - 1)][k])+ ((j == N - 1) ? u[p][i][(0)][k] : u[p][i][(j + 1)][k])+ ((k == 0) ? u[p][i][j][(N - 1)] : u[p][i][j][(k - 1)])+ ((k == N - 1) ? u[p][i][j][(0)] : u[p][i][j][(k + 1)])+ ((j == 0) ? ((k == 0) ? u[p][i][(N - 1)][(N - 1)] : u[p][i][(N - 1)][(k - 1)]) : ((k == 0) ? u[p][i][(j - 1)][(N - 1)] : u[p][i][(j - 1)][(k - 1)]))+ ((j == N - 1) ? ((k == N - 1) ? u[p][i][(0)][(0)] : u[p][i][(0)][(k + 1)]) : ((k == N - 1) ? u[p][i][(j + 1)][(0)] : u[p][i][(j + 1)][(k + 1)]))+ ((i == 0) ? ((k == 0) ? u[p][(N - 1)][j][(N - 1)] : u[p][(N - 1)][j][(k - 1)]) : ((k == 0) ? u[p][(i - 1)][j][(N - 1)] : u[p][(i - 1)][j][(k - 1)]))+ ((i == N - 1) ? ((k == N - 1) ? u[p][(0)][j][(0)] : u[p][(0)][j][(k + 1)]) : ((k == N - 1) ? u[p][(i + 1)][j][(0)] : u[p][(i + 1)][j][(k + 1)]));
          }
        }
      }
